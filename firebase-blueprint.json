{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Customer or staff public profile linked to Firebase Auth UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "favouriteItemIds": { "type": "array", "description": "Up to 50 favourite menu item IDs" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "role", "favouriteItemIds", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Food menu category for African, Sierra Leonean, and American dishes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9\\-]+$" },
        "cuisineGroup": { "type": "string", "enum": ["African & West African", "American Favourites", "Sides & Drinks"] },
        "description": { "type": "string", "maxLength": 300 },
        "sortOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "cuisineGroup", "description", "sortOrder", "isActive", "updatedAt"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Individual dish or drink item on the digital food menu",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "categoryId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "categoryName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "cuisineType": { "type": "string", "enum": ["Sierra Leonean", "West African", "American", "Seafood", "Small Chops", "Natural Drinks", "Sides", "Drinks"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 600 },
        "price": { "type": "number" },
        "imageKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "imageUrl": { "type": "string", "maxLength": 150000 },
        "isAvailable": { "type": "boolean" },
        "isPopular": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "spiceLevel": { "type": "string", "enum": ["Mild", "Medium", "Hot", "Authentic Hot", "Custom"] },
        "prepTimeMinutes": { "type": "number" },
        "dietaryNotes": { "type": "string", "maxLength": 200 },
        "stockQuantity": { "type": "number", "description": "Current available portions in kitchen inventory" },
        "lowStockThreshold": { "type": "number", "description": "Portion threshold at or below which a low stock alert is triggered" },
        "trackInventory": { "type": "boolean", "description": "Whether inventory tracking and low stock alerts are enabled for this item" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "name",
        "categoryId",
        "categoryName",
        "cuisineType",
        "description",
        "price",
        "imageKey",
        "imageUrl",
        "isAvailable",
        "isPopular",
        "isFeatured",
        "spiceLevel",
        "prepTimeMinutes",
        "dietaryNotes",
        "updatedAt"
      ]
    },
    "FoodImage": {
      "title": "FoodImage",
      "description": "Metadata and data URL or storage reference for uploaded food images",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "menuItemId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 150000 },
        "altText": { "type": "string", "minLength": 1, "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "menuItemId", "title", "imageUrl", "altText", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer online food order with status tracking and pricing breakdown",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderReference": { "type": "string", "minLength": 4, "maxLength": 32, "pattern": "^[A-Z0-9\\-]+$" },
        "customerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "customerPhone": { "type": "string", "minLength": 5, "maxLength": 40 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "fulfillmentType": { "type": "string", "enum": ["delivery", "pickup"] },
        "deliveryZoneId": { "type": "string", "maxLength": 128 },
        "deliveryAddress": { "type": "string", "maxLength": 300 },
        "specialInstructions": { "type": "string", "maxLength": 500 },
        "paymentMethod": { "type": "string", "enum": ["cash_on_pickup", "cash_on_delivery", "online_card", "whatsapp_order"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "verified", "failed", "refunded"] },
        "status": {
          "type": "string",
          "enum": ["New Order", "Accepted", "Confirmed", "Preparing", "Ready for Pickup", "Out for Delivery", "Completed", "Cancelled"]
        },
        "itemsSummary": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "itemCount": { "type": "number" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "taxAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "orderReference",
        "customerUid",
        "customerName",
        "customerPhone",
        "customerEmail",
        "fulfillmentType",
        "deliveryZoneId",
        "deliveryAddress",
        "specialInstructions",
        "paymentMethod",
        "paymentStatus",
        "status",
        "itemsSummary",
        "itemCount",
        "subtotal",
        "deliveryFee",
        "taxAmount",
        "totalAmount",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Line item belonging to a parent Order subcollection",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "menuItemId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "unitPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "lineTotal": { "type": "number" },
        "specialInstructions": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "orderId", "customerUid", "menuItemId", "name", "unitPrice", "quantity", "lineTotal", "specialInstructions"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Private customer contact record isolated by UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 5, "maxLength": 40 },
        "email": { "type": "string", "maxLength": 120 },
        "defaultAddress": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "phone", "email", "defaultAddress", "updatedAt"]
    },
    "RestaurantSetting": {
      "title": "RestaurantSetting",
      "description": "Global restaurant configuration managed by the owner in the admin dashboard",
      "type": "object",
      "properties": {
        "restaurantName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 200 },
        "address": { "type": "string", "minLength": 1, "maxLength": 250 },
        "phone": { "type": "string", "minLength": 1, "maxLength": 40 },
        "whatsappNumber": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "minLength": 1, "maxLength": 120 },
        "openingHours": { "type": "string", "minLength": 1, "maxLength": 300 },
        "currencySymbol": { "type": "string", "minLength": 1, "maxLength": 10 },
        "defaultDeliveryFee": { "type": "number" },
        "taxRatePercent": { "type": "number" },
        "pickupEnabled": { "type": "boolean" },
        "deliveryEnabled": { "type": "boolean" },
        "cashOnPickupEnabled": { "type": "boolean" },
        "cashOnDeliveryEnabled": { "type": "boolean" },
        "onlineCardEnabled": { "type": "boolean" },
        "whatsappOrderingEnabled": { "type": "boolean" },
        "instagramUrl": { "type": "string", "maxLength": 250 },
        "facebookUrl": { "type": "string", "maxLength": 250 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "restaurantName",
        "tagline",
        "address",
        "phone",
        "whatsappNumber",
        "email",
        "openingHours",
        "currencySymbol",
        "defaultDeliveryFee",
        "taxRatePercent",
        "pickupEnabled",
        "deliveryEnabled",
        "cashOnPickupEnabled",
        "cashOnDeliveryEnabled",
        "onlineCardEnabled",
        "whatsappOrderingEnabled",
        "instagramUrl",
        "facebookUrl",
        "updatedAt"
      ]
    },
    "DeliveryZone": {
      "title": "DeliveryZone",
      "description": "Configurable delivery zone and fee structure",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "zoneName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fee": { "type": "number" },
        "estimatedMinutes": { "type": "number" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "zoneName", "fee", "estimatedMinutes", "isActive", "updatedAt"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Payment transaction record linked to an order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "minLength": 1, "maxLength": 10 },
        "method": { "type": "string", "enum": ["cash_on_pickup", "cash_on_delivery", "online_card", "whatsapp_order"] },
        "status": { "type": "string", "enum": ["pending", "verified", "failed", "refunded"] },
        "providerRef": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderId", "customerUid", "amount", "currency", "method", "status", "providerRef", "createdAt"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Verified customer review or guestbook feedback submitted by authenticated diners",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "dishOrdered": { "type": "string", "minLength": 1, "maxLength": 120 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 5, "maxLength": 500 },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorUid", "authorName", "dishOrdered", "rating", "comment", "isApproved", "createdAt"]
    },
    "GalleryImage": {
      "title": "GalleryImage",
      "description": "Curated restaurant and culinary photography gallery item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": {
          "type": "string",
          "enum": [
            "Sierra Leonean Dishes",
            "West African Traditional",
            "American Meals",
            "Seafood",
            "Restaurant Interior",
            "Food Preparation",
            "Catering Events"
          ]
        },
        "caption": { "type": "string", "minLength": 1, "maxLength": 300 },
        "imageKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "imageUrl": { "type": "string", "maxLength": 150000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "category", "caption", "imageKey", "imageUrl", "updatedAt"]
    },
    "CateringEnquiry": {
      "title": "CateringEnquiry",
      "description": "Customer catering and private event enquiry submitted from the Catering page",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 5, "maxLength": 40 },
        "email": { "type": "string", "minLength": 3, "maxLength": 120 },
        "eventType": { "type": "string", "minLength": 1, "maxLength": 100 },
        "eventDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "guestCount": { "type": "number" },
        "foodPreferences": { "type": "string", "minLength": 1, "maxLength": 500 },
        "additionalRequirements": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["New", "Reviewed", "Quoted", "Confirmed", "Archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "customerUid",
        "fullName",
        "phone",
        "email",
        "eventType",
        "eventDate",
        "guestCount",
        "foodPreferences",
        "additionalRequirements",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "User profile document keyed by Firebase Auth UID"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Publicly readable menu categories managed by admins"
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Publicly readable digital food menu items managed by admins"
    },
    "/food_images/{imageId}": {
      "schema": { "$ref": "#/entities/FoodImage" },
      "description": "Uploaded or custom food photography records managed by admins"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders accessible only to the ordering customer or admins"
    },
    "/orders/{orderId}/order_items/{orderItemId}": {
      "schema": { "$ref": "#/entities/OrderItem" },
      "description": "Subcollection of line items belonging to an order"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Strictly isolated PII contact details accessible only to the owner or admin"
    },
    "/restaurant_settings/{settingId}": {
      "schema": { "$ref": "#/entities/RestaurantSetting" },
      "description": "Global restaurant settings document readable by all and editable only by admins"
    },
    "/delivery_zones/{zoneId}": {
      "schema": { "$ref": "#/entities/DeliveryZone" },
      "description": "Configurable delivery zones readable by all and editable by admins"
    },
    "/payment_transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/PaymentTransaction" },
      "description": "Payment records isolated to the ordering customer and admins"
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Verified customer testimonials approved by admin"
    },
    "/gallery_images/{galleryId}": {
      "schema": { "$ref": "#/entities/GalleryImage" },
      "description": "Curated restaurant gallery items readable by all and editable by admins"
    },
    "/catering_enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/CateringEnquiry" },
      "description": "Customer catering enquiries isolated to the submitting customer and admins"
    },
    "/admins/{adminUid}": {
      "schema": "AdminMarker",
      "description": "Admin role lookup collection"
    }
  }
}
